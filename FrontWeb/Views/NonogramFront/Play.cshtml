@using Shared
@model NonogramDTO;

@{
    var cellSize = 24;
    var gap = 2;
    var rowHintWidth = Model.Nonogram.MaxRowHintsCount * cellSize + (Model.Nonogram.MaxRowHintsCount - 1) * gap;
    var colHintHeight = Model.Nonogram.MaxColHintsCount * cellSize + (Model.Nonogram.MaxColHintsCount - 1) * gap;
    var gridWidth = Model.Nonogram.Width * cellSize + (Model.Nonogram.Width - 1) * gap;
}

<div class="play-wrapper">
    <div class="d-flex justify-content-between m-2">
        <a asp-action="Index" class="btn btn-outline-secondary me-2">
            ← All nonograms
        </a>
        <div style="width: 15%;"></div>
        <div style="width: 15%;"></div>
    </div>

    <div class="nonogram-scale-wrapper">
        <div class="nonogram-wrapper" id="nonogram">
            <div style=" text-align:center;">
                <span id="LivesDisplay"></span>
                <div style="width: 15%;"></div>
            </div>

            <div class="nonogram-top d-flex" style="margin-right:@(rowHintWidth)px;">
                <div class="nonogram-corner" style="width:@(rowHintWidth)px; height:@(colHintHeight)px;"></div>

                <div class="col-hints-grid d-flex">
                    @for (int col = 0; col < Model.Nonogram.ColHints.Count; col++)
                    {
                        <div class="col-hint-column d-flex flex-column justify-content-end" data-col="@col">
                            @for (int e = 0; e < Model.Nonogram.MaxColHintsCount - Model.Nonogram.ColHints[col].Count; e++)
                            {
                                <div class="hint-cell empty"></div>
                            }

                            @for (int j = 0; j < Model.Nonogram.ColHints[col].Count; j++)
                            {
                                <div class="hint-cell">
                                    @Model.Nonogram.ColHints[col][j]
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="nonogram-middle d-flex" style="margin-right:@(rowHintWidth)px;">
                <div class="row-hints-grid d-flex flex-column">
                    @for (int row = 0; row < Model.Nonogram.RowHints.Count; row++)
                    {
                        <div class="row-hint-row d-flex justify-content-end" data-row="@row">
                            @for (int e = 0; e < Model.Nonogram.MaxRowHintsCount - Model.Nonogram.RowHints[row].Count; e++)
                            {
                                <div class="hint-cell empty"></div>
                            }

                            @for (int j = 0; j < Model.Nonogram.RowHints[row].Count; j++)
                            {
                                <div class="hint-cell">
                                    @Model.Nonogram.RowHints[row][j]
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="nonogram-grid" data-id="@Model.Nonogram.Id" data-solution="@Model.SolutionJson" data-difficulty="@Model.Nonogram.Difficulty" style="grid-template-columns: repeat(@Model.Nonogram.Width, 24px);">
                    @for (var row = 0; row < Model.Nonogram.Height; row++)
                    {
                        for (var col = 0; col < Model.Nonogram.Width; col++)
                        {
                            <div class="cell" data-row="@row" data-col="@col"></div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div style="width: 15%" ;></div>

    <div id="game-over-modal" class="game-modal d-none">
        <div class="game-modal-content">
            <h3 class="mb-2">You`ve lost 💀</h3>
            <p class="mb-3">Lives are over.</p>
            <button id="game-over-restart" class="btn btn-primary btn-sm">
                Play again
            </button>
        </div>
    </div>

    <div id="game-win-modal" class="game-modal d-none">
        <div class="game-modal-content">
            <h3 class="mb-2">You won</h3>
            <p class="mb-3">Сongratulations!</p>
            <button id="game-win-close" class="btn btn-primary btn-sm">
                Close this window
            </button>
        </div>
    </div>

</div>



<script src="~/js/game.js"></script>

